# Backend Port (Defaults to 5000 locally, dynamically provided on Render/Heroku)
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/smilecare_db?retryWrites=true&w=majority
